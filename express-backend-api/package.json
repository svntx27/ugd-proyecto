{
  "name": "express-backend-api",
  "module": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "db:generate": "prisma generate",
    "db:push": "bunx prisma db push",
    "db:setup:demo": "bun run db:push && bun run db:seed:all:demo",
    "db:setup:official": "bun run db:push && bun run db:seed:all:official",
    "db:seed": "bun run prisma/seed.ts",
    "db:seed:demo": "bun run prisma/seed-doctorandos.ts --demo",
    "db:seed:official": "bun run prisma/seed-doctorandos.ts --official",
    "db:seed:doctorandos": "bun run prisma/seed-doctorandos.ts",
    "db:seed:all": "bun run prisma/seed.ts && bun run prisma/seed-doctorandos.ts",
    "db:seed:all:demo": "bun run prisma/seed.ts --demo && bun run prisma/seed-doctorandos.ts --demo",
    "db:seed:all:official": "bun run prisma/seed.ts --official && bun run prisma/seed-doctorandos.ts --official",
    "db:anonymize": "node prisma/data/demo/anonymize-sql.mjs",
    "db:studio": "bunx prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "prisma": "6.4.0",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "6.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
