---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { SaludoDoctorando } from '../../components/auth/SaludoDoctorando';
import { CrearContrasenaForm } from '../../components/auth/CrearContrasenaForm';
---
<AuthLayout
  title="Crear contraseña"
  badge="Validación Académica"
>
  <!-- Los datos del doctorando viven en el navegador (paso 1), por eso estas islas no se renderizan en el servidor -->
  <SaludoDoctorando slot="lateral" client:only="react" />

  <CrearContrasenaForm client:only="react" />
</AuthLayout>
