---
import AuthLayout from '../layouts/AuthLayout.astro';
import { VerificacionForm } from '../components/auth/VerificacionForm';
---
<AuthLayout
  title="Activar cuenta"
  heading="Validación de Nómina Doctoral"
  subheading="Comprobamos tu registro en la nómina oficial de la Unidad de Gestión de Doctorados (UGD) para habilitar tu acceso seguro al portal."
  badge="Nómina Oficial UGD"
>
  <!-- Barra de progreso e indicador de paso directo (sin títulos redundantes) -->
  <div class="mb-8 space-y-2.5">
    <div class="flex items-center justify-between text-xs font-medium text-muted">
      <span class="text-sm font-semibold text-text-main">1. Verificación de identidad</span>
      <span class="text-xs text-muted">Paso 2: Contraseña</span>
    </div>
    <div class="flex gap-1.5 h-1">
      <div class="flex-1 rounded-full bg-primary"></div>
      <div class="flex-1 rounded-full bg-border-subtle"></div>
    </div>
    <p class="text-xs text-muted">
      Ingresa tu cédula y correo institucional para validar tu registro en el padrón de la UGD.
    </p>
  </div>

  <VerificacionForm client:load />

  <p class="mt-6 text-center text-sm text-text-body">
    ¿Ya activaste tu cuenta?{' '}
    <a href="/login" class="font-medium text-primary hover:text-primary-hover hover:underline">
      Inicia sesión aquí
    </a>
  </p>
</AuthLayout>
